# Copy to .env and fill in. Never commit the real .env.

# --- Django ------------------------------------------------------------------
# Required unless DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Demo mode (judges/testing: no Termii keys needed) --------------------------
DEMO_MODE=False
DEMO_OTP_CODE=123456
# Payments inside Demo mode: True (default) uses the internal simulated
# checkout, so no PayPal account is needed. Set False to keep the OTP
# stub but run REAL PayPal sandbox payments (needs PAYPAL_* keys plus a
# sandbox buyer account to approve with).
DEMO_SIMULATE_PAYMENTS=True
# Only for an intentional demo deployment with DJANGO_DEBUG=False.
DEMO_ALLOW_PROD=False

# --- PayPal (Orders v2 + Payouts, sandbox by default) --------------------------
# Create a sandbox app at https://developer.paypal.com to get these.
# PAYPAL_MODE=sandbox|live, PAYPAL_WEBHOOK_ID from your webhook registration.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_EMAIL=

# --- Baseten (agentic AI, OpenAI-compatible) -----------------------------------
# Either provider works; MODAL_* wins when set (shared endpoint preferred,
# see README; modal_app.py is the self-host fallback).
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Reasoning budget per turn (chain-of-thought + answer share it).
INFERENCE_MAX_TOKENS=16384

# --- Modal (overrides Baseten when set) --------------------------------------
# PREFERRED: use a Modal shared endpoint (no GPUs to provision). Create it
# (dashboard Endpoints tab, or: modal endpoint create --shared
# --model meta-models/Muse-Spark-Open), mint a proxy token
# (modal workspace proxy-tokens create), then:
# MODAL_BASE_URL=https://inference.us-west.modal.direct/v1
# MODAL_API_KEY=<proxy token id>.<proxy token secret>  (joined by a dot)
# MODAL_MODEL=<endpoint hostname from the dashboard>
# Use the blank block below only for full self-hosting via modal_app.py.
# MODAL_API_KEY=
# MODAL_BASE_URL=
# MODAL_MODEL=

# --- Muse Voice Transcribe (Meta Model API; separate key from Baseten) -------
MODEL_API_KEY=
ASR_BASE_URL=https://api.meta.ai
ASR_MODEL=muse-voice-transcribe-1.0
VOICE_MAX_BYTES=8388608
VOICE_TIMEOUT=60

# --- WhatsApp (needed from the WhatsApp phase on) -----------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Termii (email OTP) ---------------------------------------------
TERMII_API_KEY=
TERMII_EMAIL_CONFIG_ID=
# Live delivery while DJANGO_DEBUG=True. Without this, DEBUG short-circuits
# to a mock that returns True without emailing anything (plus optional
# LOG_OTP_TO_CONSOLE below). Enable only for live local testing.
TERMII_SEND_IN_DEBUG=False
# Agent/voice request budgets (sync with Procfile web timeout below)
AGENT_MAX_ITERATIONS=8
AGENT_REQUEST_TIMEOUT=60
VOICE_TIMEOUT=60

# --- Email (counterparty invitations; console backend in DEBUG) --------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Locktrans.AI <no-reply@locktrans.example>

# --- Tunables ----------------------------------------------------------------
DATABASE_URL=
# Redis etc. supported via CACHE_BACKEND=CACHE_LOCATION, e.g.
# django.core.cache.backends.redis.RedisCache / redis://localhost:6379/0
# CACHE_BACKEND=
# CACHE_LOCATION=
# Sessions stay database-backed even when the cache above is swapped out.
SESSION_ENGINE=django.contrib.sessions.backends.db
# Seconds before an outbound gateway call is abandoned.
GATEWAY_HTTP_TIMEOUT=15
# Minimum gap between OTPs sent to the same address for the same purpose.
OTP_ISSUE_COOLDOWN_SECONDS=60
# Print one-time codes to the log. Leave off outside local development.
LOG_OTP_TO_CONSOLE=False
LOG_LEVEL=INFO

# --- Required when DJANGO_DEBUG=False ---------------------------------------
CSRF_TRUSTED_ORIGINS=https://escrow.example.com
SECURE_SSL_REDIRECT=True
